<?xml version="1.0"?>
<scenario>

    <looks>
        <look name="crab" gray="1.0" roughness="0.4" metalness="0.5" texture="objects/crab/crab.png"/>
    </looks>

    <animated name="AnimMesh" type="model" collisions="false">
        <physical>
            <mesh filename="objects/crab/crab_phy.obj" scale="0.1"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="objects/crab/crab.obj" scale="0.1"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Neutral"/>
        <look name="crab"/>
        <trajectory type="spline" playback="boomerang">
            <keypoint time="0.0" xyz="2.5 0.0 5.95" rpy="0.0 0.0 0.0"/>
            <keypoint time="5.0" xyz="2.5 0.0 5.95" rpy="0.0 0.0 1.57"/>
            <keypoint time="10.0" xyz="2.5 0.0 5.95" rpy="0.0 0.0 3.14"/>
            <keypoint time="10.5" xyz="2.5 0.0 5.95" rpy="0.0 0.0 3.14"/>
        </trajectory>
    </animated>

</scenario>