<?xml version="1.0"?>
<scenario>
    <environment>
        <ned latitude="41.7777" longitude="3.0333"/>
        <ocean>
            <water density="1000.0" jerlov="0.2"/>
        </ocean>
        <atmosphere>
            <sun azimuth="40.0" elevation="60.0"/>
        </atmosphere>
    </environment>

    <materials>
        <material name="Neutral" density="1000.0" restitution="0.1"/>
        <material name="Rock" density="3000.0" restitution="0.8"/>
        <material name="Fiberglass" density="1500.0" restitution="0.3"/>
        <material name="Aluminium" density="2710.0" restitution="0.5"/>
        <friction_table>
            <friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2"/>
            <friction material1="Neutral" material2="Rock" static="0.2" dynamic="0.1"/>
            <friction material1="Neutral" material2="Fiberglass" static="0.5" dynamic="0.2"/>
            <friction material1="Neutral" material2="Aluminium" static="0.1" dynamic="0.02"/>
            <friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7"/>
            <friction material1="Rock" material2="Fiberglass" static="0.6" dynamic="0.4"/>
            <friction material1="Rock" material2="Aluminium" static="0.6" dynamic="0.3"/>
            <friction material1="Fiberglass" material2="Fiberglass" static="0.5" dynamic="0.2"/>
            <friction material1="Fiberglass" material2="Aluminium" static="0.5" dynamic="0.2"/>
            <friction material1="Aluminium" material2="Aluminium" static="0.8" dynamic="0.5"/>
        </friction_table>
    </materials>

    <looks>
        <look name="Yellow" rgb="1.0 0.9 0.0" roughness="1"/>
        <look name="Gray" gray="0.3" roughness="0.4" metalness="0.5"/>
        <look name="terrain" gray="1.0" roughness="1.0" texture="terrain_color.png" uv_scale="0.05"/>
        <look name="sand" gray="1.0" roughness="1.0" texture="sand_color.png" uv_scale="100"/>
        <look name="platform" gray="1.0" roughness="0.1" texture="platform_text.png"/>
        <look name="structure" gray="1.0" roughness="0.1" texture="moss.jpg" normal_map="moss_normal.png"/>
    </looks>

    <static name="platform" type="model">
        <physical>
            <mesh filename="platform_collision.obj" scale="1.0"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="platform.obj" scale="1.0"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <material name="Rock"/>
        <look name="platform"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 10.0"/>
    </static>

    <static name="structure" type="model">
        <physical>
            <mesh filename="structure_collision.obj" scale="1.0"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="structure.obj" scale="1.0"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <look name="structure"/>
        <material name="Rock"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-5.0 0.0 10.0"/>
    </static>

    <include file="$(find obsea_sim)/scenarios/tripod.scn">
        <arg name="position" value="3.0 0.0 8.0"/>
    </include>

    <!-- <include file="$(find obsea_sim)/scenarios/seismograph.scn">
        <arg name="position" value="3.0 0.0 8.0"/>
    </include> -->

    <!-- <static name="Bottom" type="terrain">
        <height_map filename="terrain.png"/>
        <dimensions scalex="0.05" scaley="0.05" height="2.0"/>
        <material name="Rock"/>
        <look name="terrain"/>
        <world_transform xyz="0.0 0.0 10.46" rpy="0.0 0.0 0.0"/>
    </static> -->

    <!-- <static name="Bottom" type="terrain">
        <height_map filename="sand.png"/>
        <dimensions scalex="0.1" scaley="0.1" height="0.02"/>
        <material name="Rock"/>
        <look name="sand"/>
        <world_transform xyz="0.0 0.0 10.46" rpy="0.0 0.0 0.0"/>
    </static> -->

    <static name="Floor" type="plane">
        <material name="Rock"/>
        <look name="sand"/>
        <world_transform xyz="0.0 0.0 10.0" rpy="0.0 0.0 0.0"/>
    </static>

    <include file="$(find obsea_sim)/scenarios/girona1000bravo.scn">
        <arg name="robot_name" value="girona1000"/>
        <arg name="start_yaw" value="-1.57"/>
        <arg name="start_position" value="-5.0 5.0 8.0"/>
    </include>

</scenario>